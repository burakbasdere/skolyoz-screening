{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skolyoz curated metrics",
  "type": "object",
  "required": [
    "schema_version", "updated", "policy", "evaluations", "landmark_error", "angle_error",
    "screening_decision", "two_stage_ablation", "export_variants", "model_complexity",
    "artifacts", "parity", "jvm_preprocessing", "device_reported", "robustness", "dataset",
    "negative_results", "gaps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "policy": {"type": "string"},
    "evaluations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/evaluation"}
    },
    "landmark_error": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["evaluation", "rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["type", "n", "median_px", "p90_px", "label_floor_px"],
          "properties": {
            "type": {"type": "string"}, "n": {"type": "integer", "minimum": 1},
            "median_px": {"type": "number", "minimum": 0}, "p90_px": {"type": "number", "minimum": 0},
            "label_floor_px": {"type": ["number", "null"]}
          }
        }}
      }
    },
    "angle_error": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["evaluation", "rows", "label_floor_averaged_deg"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["measurement", "median_deg", "p90_deg", "signal_median_deg", "label_floor_deg"],
          "properties": {
            "measurement": {"type": "string"},
            "median_deg": {"type": "number", "minimum": 0}, "p90_deg": {"type": "number", "minimum": 0},
            "signal_median_deg": {"type": "number", "exclusiveMinimum": 0},
            "label_floor_deg": {"type": ["number", "null"]}
          }
        }}
      }
    },
    "screening_decision": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["evaluation", "n", "rows"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["threshold_deg", "positives", "true_positives", "correct", "accuracy", "macro_f1", "recall"],
          "properties": {
            "threshold_deg": {"type": "number"},
            "positives": {"type": "integer", "minimum": 1}, "true_positives": {"type": "integer", "minimum": 0},
            "correct": {"type": "integer", "minimum": 0},
            "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
            "macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
            "recall": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }}
      }
    },
    "two_stage_ablation": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["evaluation", "rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["metric", "unit", "stage1", "stage1_plus_2", "floor"],
          "properties": {
            "metric": {"type": "string"}, "unit": {"type": "string"},
            "stage1": {"type": "number"}, "stage1_plus_2": {"type": "number"},
            "floor": {"type": ["number", "null"]}
          }
        }}
      }
    },
    "export_variants": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["evaluation", "rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["variant", "selected", "size_mb", "median_px", "median_deg", "shoulder_accuracy", "note"],
          "properties": {
            "variant": {"type": "string"}, "selected": {"type": "boolean"},
            "size_mb": {"type": ["number", "null"]}, "median_px": {"type": ["number", "null"]},
            "median_deg": {"type": ["number", "null"]}, "shoulder_accuracy": {"type": ["number", "null"]},
            "note": {"type": ["string", "null"]}
          }
        }}
      }
    },
    "model_complexity": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["model", "params", "gflops", "input", "note"],
          "properties": {
            "model": {"type": "string"}, "params": {"type": "integer", "minimum": 1},
            "gflops": {"type": ["number", "null"]}, "input": {"type": "string"},
            "note": {"type": ["string", "null"]}
          }
        }}
      }
    },
    "artifacts": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object",
          "required": ["file", "bytes", "sha256", "note"],
          "properties": {
            "file": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "note": {"type": "string"}
          }
        }}
      }
    },
    "parity": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["jvm_unit_tests", "instrumented_tests", "golden_rows", "acceptance_tolerance_deg"],
      "properties": {
        "jvm_unit_tests": {"type": "integer", "minimum": 0},
        "instrumented_tests": {"type": "integer", "minimum": 0},
        "golden_rows": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "acceptance_tolerance_deg": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "jvm_preprocessing": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["step", "ms"],
          "properties": {"step": {"type": "string"}, "ms": {"type": "number", "minimum": 0}}
        }}
      }
    },
    "device_reported": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["device", "shutter_latency_ms", "imu"],
      "properties": {
        "device": {"type": "string"},
        "shutter_latency_ms": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["change", "total_ms"],
          "properties": {"change": {"type": "string"}, "total_ms": {"type": "number", "exclusiveMinimum": 0}}
        }},
        "imu": {"type": "object"}
      }
    },
    "robustness": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["item", "value", "context"],
          "properties": {"item": {"type": "string"}, "value": {"type": "string"}, "context": {"type": "string"}}
        }}
      }
    },
    "dataset": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["item", "value"],
          "properties": {"item": {"type": "string"}, "value": {"type": ["string", "number"]}}
        }}
      }
    },
    "negative_results": {
      "allOf": [{"$ref": "#/$defs/section"}],
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["approach", "result", "reason"],
          "properties": {"approach": {"type": "string"}, "result": {"type": "string"},
                         "reason": {"type": ["string", "null"]}}
        }}
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "what", "why", "next"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "status": {"enum": ["not_measured", "unvalidated"]},
          "what": {"type": "string"}, "why": {"type": "string"}, "next": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "status": {"enum": ["reported", "measured"]},
    "section": {
      "type": "object",
      "required": ["status", "source"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "source": {"type": "string", "minLength": 1},
        "evaluation": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["title", "protocol", "model", "n_images", "status", "source", "reproduce", "requires_private_data"],
      "properties": {
        "title": {"type": "string"}, "protocol": {"type": "string"}, "model": {"type": "string"},
        "n_images": {"type": "integer", "minimum": 1}, "n_landmarks": {"type": "integer", "minimum": 1},
        "status": {"$ref": "#/$defs/status"},
        "source": {"type": "string"},
        "reproduce": {"type": "array", "items": {"type": "string"}},
        "requires_private_data": {"type": "boolean"}
      }
    }
  }
}
