<?xml version="1.0" encoding="utf-8"?>
<!-- Simge: egik bir koltuk alti cizgisi + kesikli yercekimi yatayi.
     Urunun olctugu seyin kendisi. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- kesikli yercekimi yatayi -->
    <path
        android:pathData="M32,54 h8 M44,54 h8 M56,54 h8 M68,54 h8"
        android:strokeColor="#AAAAAA"
        android:strokeWidth="2.5" />

    <!-- egik koltuk alti cizgisi -->
    <path
        android:pathData="M34,60 L74,48"
        android:strokeColor="#FFCD00"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- sag nokta (kirmizi) / sol nokta (mavi) -->
    <path
        android:pathData="M34,60 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FF4646" />
    <path
        android:pathData="M74,48 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#46A0FF" />
</vector>
